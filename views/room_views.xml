<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_room_form" model="ir.ui.view">
        <field name="name">library.room.form</field>
        <field name="model">library.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,occupied,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Room Name"/></h1>
                    </div>
                    <group>
                        <group string="Room Info">
                            <field name="capacity"/>
                            <field name="current_occupancy"/>
                            <field name="is_crowded"/>
                            <field name="description"/>
                        </group>
                        <group string="Computers">
                            <field name="has_computers"/>
                            <field name="computer_count"
                                   invisible="not has_computers"/>
                            <field name="computers_available"
                                   invisible="not has_computers"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bookings">
                            <field name="booking_ids">
                                <list>
                                    <field name="member_id"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="duration_hours"/>
                                    <field name="needs_computer"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_room_list" model="ir.ui.view">
        <field name="name">library.room.list</field>
        <field name="model">library.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="capacity"/>
                <field name="current_occupancy"/>
                <field name="has_computers"/>
                <field name="computers_available"/>
                <field name="is_crowded"/>
                <field name="state"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'occupied'"
                       decoration-danger="state == 'maintenance'"/>
            </list>
        </field>
    </record>

    <record id="action_library_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">library.room</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
