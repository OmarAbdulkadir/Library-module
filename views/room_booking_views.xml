<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_room_booking_form" model="ir.ui.view">
        <field name="name">library.room.booking.form</field>
        <field name="model">library.room.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="✓ Approve" type="object"
                            class="btn-primary"
                            invisible="state != 'pending'"
                            groups="library.group_library_staff,library.group_library_admin"/>
                    <button name="action_reject" string="✗ Reject" type="object"
                            class="btn-danger"
                            invisible="state != 'pending'"
                            groups="library.group_library_staff,library.group_library_admin"/>
                    <button name="action_checkin" string="Check In" type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="library.group_library_staff,library.group_library_admin"/>
                    <button name="action_checkout" string="Check Out" type="object"
                            class="btn-primary"
                            invisible="state != 'active'"
                            groups="library.group_library_staff,library.group_library_admin"/>
                    <button name="action_cancel" string="Cancel Booking" type="object"
                            class="btn-secondary"
                            invisible="state in ['done', 'cancelled', 'rejected']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,active,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Booking Details">
                            <field name="member_id"/>
                            <field name="room_id"/>
                            <field name="booking_date"/>
                            <field name="time_slot"/>
                            <field name="group_size"/>
                            <field name="needs_computer"/>
                            <field name="language"/>
                        </group>
                        <group string="Time Info">
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration_hours"/>
                            <field name="auto_cancel_time"/>
                        </group>
                    </group>
                    <group string="QR Code" invisible="not qr_code">
                        <field name="qr_code" widget="image" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                        <field name="rejection_reason" nolabel="1"
                               invisible="state not in ['rejected']"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_library_room_booking_list" model="ir.ui.view">
        <field name="name">library.room.booking.list</field>
        <field name="model">library.room.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="member_id"/>
                <field name="room_id"/>
                <field name="booking_date"/>
                <field name="time_slot"/>
                <field name="group_size"/>
                <field name="needs_computer"/>
                <field name="state"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'done'"
                       decoration-primary="state == 'approved'"
                       decoration-warning="state == 'active'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="action_library_room_booking" model="ir.actions.act_window">
        <field name="name">Room Bookings</field>
        <field name="res_model">library.room.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
