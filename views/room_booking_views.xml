<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_room_booking_form" model="ir.ui.view">
        <field name="name">library.room.booking.form</field>
        <field name="model">library.room.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state != 'pending'"/>
                    <button name="action_checkin" string="Check In"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_checkout" string="Check Out"
                            type="object" class="oe_highlight"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state not in ('pending', 'approved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,active,done"/>
                </header>
                <sheet>
                    <div class="row">
                        <div class="col-8">
                            <group>
                                <group string="Booking Details">
                                    <field name="member_id"/>
                                    <field name="room_id"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="duration_hours"/>
                                    <field name="needs_computer"/>
                                </group>
                                <group string="Notes">
                                    <field name="notes" nolabel="1"/>
                                    <field name="rejection_reason"
                                           invisible="state != 'rejected'"
                                           nolabel="1"/>
                                </group>
                            </group>
                        </div>
                        <div class="col-4" invisible="not qr_code">
                            <group string="QR Code">
                                <field name="qr_code" widget="image"
                                       string="Scan to Check In/Out"
                                       nolabel="1"/>
                            </group>
                        </div>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_library_room_booking_list" model="ir.ui.view">
        <field name="name">library.room.booking.list</field>
        <field name="model">library.room.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="member_id"/>
                <field name="room_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration_hours"/>
                <field name="needs_computer"/>
                <field name="state"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'approved'"
                       decoration-warning="state == 'active'"
                       decoration-danger="state in ('cancelled', 'rejected')"
                       decoration-muted="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_library_room_booking_search" model="ir.ui.view">
        <field name="name">library.room.booking.search</field>
        <field name="model">library.room.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id"/>
                <field name="room_id"/>
                <filter string="Pending" name="pending"
                        domain="[('state','=','pending')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state','=','approved')]"/>
                <filter string="Active" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Done" name="done"
                        domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>

    <record id="action_library_room_booking" model="ir.actions.act_window">
        <field name="name">Room Bookings</field>
        <field name="res_model">library.room.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_library_room_booking_search"/>
    </record>

</odoo>
