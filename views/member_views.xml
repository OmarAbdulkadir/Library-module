<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_suspend" string="Suspend"
                            type="object" class="oe_highlight"
                            invisible="state == 'suspended'"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state == 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Full Name"/></h1>
                    </div>
                    <group>
                        <group string="Contact Info">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="student_id"/>
                            <field name="membership_date"/>
                        </group>
                        <group string="Borrowing Stats">
                            <field name="borrow_limit"/>
                            <field name="active_borrows"/>
                            <field name="total_borrows"/>
                            <field name="streak"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Borrow History">
                            <field name="borrow_ids">
                                <list>
                                    <field name="book_id"/>
                                    <field name="borrow_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state"
                                           decoration-success="state == 'returned'"
                                           decoration-danger="state == 'overdue'"
                                           decoration-info="state == 'borrowed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Room Bookings">
                            <field name="room_booking_ids">
                                <list>
                                    <field name="room_id"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="duration_hours"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_library_member_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="email"/>
                <field name="borrow_limit"/>
                <field name="active_borrows"/>
                <field name="streak"/>
                <field name="state"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'suspended'"/>
            </list>
        </field>
    </record>

    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
