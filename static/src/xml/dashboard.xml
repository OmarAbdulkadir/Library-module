<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="library.Dashboard">
  <div t-att-class="'lib-dashboard lib-mood-' + state.ambientMood">

    <div class="lib-navbar">
      <div class="lib-navbar-brand">
        <span class="brand-icon">📚</span>
        <span class="brand-name">OSTIM University Library</span>
      </div>
      <div class="lib-navbar-tabs">
        <button class="lib-nav-tab" t-att-class="state.activeTab === 'dashboard' ? 'active' : ''" t-on-click="() => this.setTab('dashboard')">🏠 Dashboard</button>
        <button class="lib-nav-tab" t-att-class="state.activeTab === 'books' ? 'active' : ''" t-on-click="() => this.setTab('books')">📖 Books</button>
        <button t-if="state.isStaff" class="lib-nav-tab" t-att-class="state.activeTab === 'members' ? 'active' : ''" t-on-click="() => this.setTab('members')">👥 Members</button>
        <button t-if="state.isStaff" class="lib-nav-tab" t-att-class="state.activeTab === 'borrows' ? 'active' : ''" t-on-click="() => this.setTab('borrows')">
          📋 Borrowings
          <span t-if="state.stats.overdueCount &gt; 0" class="tab-badge overdue-badge"><t t-esc="state.stats.overdueCount"/></span>
        </button>
        <button class="lib-nav-tab" t-att-class="state.activeTab === 'rooms' ? 'active' : ''" t-on-click="() => this.setTab('rooms')">🚪 Rooms</button>
        <button class="lib-nav-tab" t-att-class="state.activeTab === 'schedule' ? 'active' : ''" t-on-click="() => this.setTab('schedule')">🗓 Schedule</button>
        <button class="lib-nav-tab" t-att-class="state.activeTab === 'bookings' ? 'active' : ''" t-on-click="() => this.setTab('bookings')">
          📅 Bookings
          <span t-if="state.isStaff and state.stats.pendingBookings &gt; 0" class="tab-badge"><t t-esc="state.stats.pendingBookings"/></span>
        </button>
        <button t-if="state.isStaff" class="lib-nav-tab" t-att-class="state.activeTab === 'stats' ? 'active' : ''" t-on-click="() => this.setTab('stats')">📊 Statistics</button>
        <button t-if="state.isPortal" class="lib-nav-tab" t-att-class="state.activeTab === 'profile' ? 'active' : ''" t-on-click="() => this.setTab('profile')">👤 My Profile</button>
        <button t-if="state.isAdmin" class="lib-nav-tab" t-att-class="state.activeTab === 'settings' ? 'active' : ''" t-on-click="() => this.setTab('settings')">⚙ Settings</button>
      </div>
      <div class="lib-navbar-right">
        <div class="lib-clock"><t t-esc="state.currentTime"/></div>
        <div t-att-class="'lib-open-badge ' + (state.libraryOpen ? 'open' : 'closed')">
          <span class="lib-open-dot"/>
          <t t-if="state.libraryOpen">OPEN</t>
          <t t-else="">CLOSED</t>
        </div>
        <span t-if="state.isAdmin" style="background:rgba(255,255,255,0.2);padding:4px 10px;border-radius:12px;font-size:12px;color:white;">👑 Admin</span>
        <span t-elif="state.isStaff" style="background:rgba(255,255,255,0.2);padding:4px 10px;border-radius:12px;font-size:12px;color:white;">👔 Staff</span>
        <span t-else="" style="background:rgba(255,255,255,0.2);padding:4px 10px;border-radius:12px;font-size:12px;color:white;">🎓 Student</span>
        <div style="position:relative;cursor:pointer;" t-on-click="() => this.setTab(state.isPortal ? 'profile' : 'borrows')">
          <span style="font-size:20px;">🔔</span>
          <span t-if="state.notificationCount > 0" style="position:absolute;top:-6px;right:-6px;background:#e53e3e;color:white;border-radius:50%;width:16px;height:16px;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;"><t t-esc="state.notificationCount"/></span>
        </div>
        <a href="/web/session/logout?redirect=/odoo/action-198" style="background:rgba(255,255,255,0.15);padding:4px 12px;border-radius:12px;font-size:12px;color:white;text-decoration:none;margin-left:6px;">🚪 Logout</a>
      </div>
    </div>

    <div t-if="state.showAnnouncement and state.announcement" class="lib-announcement">
      📢 <t t-esc="state.announcement"/>
    </div>

    <div t-if="state.isStaff and state.stats.overdueCount &gt; 0" class="lib-overdue-alert">
      ⚠ <strong><t t-esc="state.stats.overdueCount"/> overdue book(s)</strong> — please follow up with members
      <button class="lib-btn-inline" t-on-click="() => this.setTab('borrows')">View →</button>
    </div>

    <div t-if="state.loading" class="lib-loading">
      <div class="lib-spinner"/>
      <span>Loading library data...</span>
    </div>

    <div t-else="" class="lib-content">

      <!-- DASHBOARD TAB -->
      <t t-if="state.activeTab === 'dashboard'">
        <div t-att-class="'lib-mood-banner lib-animate lib-mood-banner-' + state.ambientMood" style="position:relative;overflow:hidden;">
          <span class="lib-mood-icon" style="font-size:52px;">
            <t t-if="state.ambientMood === 'quiet'">🌙</t>
            <t t-elif="state.ambientMood === 'moderate'">📖</t>
            <t t-elif="state.ambientMood === 'busy'">⚡</t>
            <t t-else="">🔥</t>
          </span>
          <div style="flex:1;">
            <div style="font-size:22px;font-weight:800;color:#1E3A5F;">
              Good <t t-if="state.libraryOpen">Day</t><t t-else="">Evening</t>
              <t t-if="state.userName">, <t t-esc="state.userName"/></t> 👋
            </div>
            <div style="font-size:14px;color:#4a5568;margin-top:4px;">
              <t t-if="state.ambientMood === 'quiet'">Library is quiet — great time to study 😌</t>
              <t t-elif="state.ambientMood === 'moderate'">Library is active — rooms filling up 📅</t>
              <t t-elif="state.ambientMood === 'busy'">Library is busy — limited space ⚠</t>
              <t t-else="">All rooms near capacity 🚫</t>
            </div>
          </div>
          <div style="display:flex;gap:10px;">
            <button t-if="state.isStaff" class="lib-btn lib-btn-primary" t-on-click="() => this.setTab('borrows')" style="font-size:12px;padding:8px 14px;">View Borrowings</button>
            <button class="lib-btn" t-on-click="() => this.setTab('schedule')" style="font-size:12px;padding:8px 14px;background:white;color:#1E3A5F;border:2px solid #1E3A5F;">Book a Room</button>
          </div>
        </div>

        <div class="lib-stats-grid">
          <div class="lib-stat-card lib-animate" t-on-click="() => this.setTab('books')" style="border-top:4px solid #4299E1;">
            <div style="font-size:36px;margin-bottom:8px;">📚</div>
            <div style="font-size:40px;font-weight:800;color:#2B6CB0;line-height:1;"><t t-esc="state.stats.books"/></div>
            <div style="font-size:11px;font-weight:700;color:#718096;text-transform:uppercase;letter-spacing:1px;margin-top:6px;">Total Books</div>
          </div>
          <div t-if="state.isStaff" class="lib-stat-card lib-animate" t-on-click="() => this.setTab('members')" style="border-top:4px solid #38B2AC;">
            <div style="font-size:36px;margin-bottom:8px;">👥</div>
            <div style="font-size:40px;font-weight:800;color:#2C7A7B;line-height:1;"><t t-esc="state.stats.members"/></div>
            <div style="font-size:11px;font-weight:700;color:#718096;text-transform:uppercase;letter-spacing:1px;margin-top:6px;">Members</div>
          </div>
          <div t-if="state.isStaff" class="lib-stat-card lib-animate" t-on-click="() => this.setTab('borrows')" style="border-top:4px solid #ED8936;">
            <div style="font-size:36px;margin-bottom:8px;">📋</div>
            <div style="font-size:40px;font-weight:800;color:#C05621;line-height:1;"><t t-esc="state.stats.borrows"/></div>
            <div style="font-size:11px;font-weight:700;color:#718096;text-transform:uppercase;letter-spacing:1px;margin-top:6px;">Active Borrows</div>
          </div>
          <div class="lib-stat-card lib-animate" t-on-click="() => this.setTab('rooms')" style="border-top:4px solid #805AD5;">
            <div style="font-size:36px;margin-bottom:8px;">🚪</div>
            <div style="font-size:40px;font-weight:800;color:#553C9A;line-height:1;"><t t-esc="state.stats.rooms"/></div>
            <div style="font-size:11px;font-weight:700;color:#718096;text-transform:uppercase;letter-spacing:1px;margin-top:6px;">Study Rooms</div>
          </div>
          <div class="lib-stat-card lib-animate" t-on-click="() => this.setTab('bookings')" style="border-top:4px solid #E53E3E;">
            <div style="font-size:36px;margin-bottom:8px;">⏳</div>
            <div style="font-size:40px;font-weight:800;color:#C53030;line-height:1;"><t t-esc="state.stats.pendingBookings"/></div>
            <div style="font-size:11px;font-weight:700;color:#718096;text-transform:uppercase;letter-spacing:1px;margin-top:6px;">Pending Bookings</div>
          </div>
        </div>

        <div t-if="state.isStaff and state.mostBorrowedBook" class="lib-featured-book lib-animate">
          <div class="lib-featured-icon">🏆</div>
          <div>
            <div class="lib-featured-label">MOST BORROWED BOOK</div>
            <div class="lib-featured-title"><t t-esc="state.mostBorrowedBook.name"/></div>
          </div>
          <div class="lib-featured-count"><t t-esc="state.mostBorrowedBook.count"/>x borrowed</div>
        </div>

        <div class="lib-room-quick lib-animate">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
            <div style="font-size:15px;font-weight:700;color:#2d3748;">🚦 Room Status</div>
            <button class="lib-btn" t-on-click="() => this.setTab('schedule')" style="font-size:12px;padding:6px 12px;background:#EBF8FF;color:#2B6CB0;border:none;border-radius:8px;cursor:pointer;font-weight:600;">View Schedule →</button>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;">
            <t t-foreach="state.rooms" t-as="room" t-key="room.id">
              <div t-on-click="() => this.setTab('schedule')" style="background:#f7fafc;border-radius:12px;padding:16px;cursor:pointer;transition:all 0.2s;border:2px solid transparent;" 
                t-att-style="'background:' + (this.getRoomLight(room) === 'green' ? '#F0FFF4' : this.getRoomLight(room) === 'yellow' ? '#FFFFF0' : '#FFF5F5') + ';border-radius:12px;padding:16px;cursor:pointer;border:2px solid ' + (this.getRoomLight(room) === 'green' ? '#68D391' : this.getRoomLight(room) === 'yellow' ? '#F6E05E' : '#FC8181') + ';'">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                  <div t-att-style="'width:12px;height:12px;border-radius:50%;background:' + (this.getRoomLight(room) === 'green' ? '#48BB78' : this.getRoomLight(room) === 'yellow' ? '#ECC94B' : '#E53E3E') + ';box-shadow:0 0 6px ' + (this.getRoomLight(room) === 'green' ? '#48BB78' : this.getRoomLight(room) === 'yellow' ? '#ECC94B' : '#E53E3E')"/>
                  <span t-att-style="'font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:' + (this.getRoomLight(room) === 'green' ? '#276749' : this.getRoomLight(room) === 'yellow' ? '#975A16' : '#9B2C2C')">
                    <t t-if="this.getRoomLight(room) === 'green'">Available</t>
                    <t t-elif="this.getRoomLight(room) === 'yellow'">Busy</t>
                    <t t-else="">Full</t>
                  </span>
                </div>
                <div style="font-size:13px;font-weight:700;color:#2d3748;"><t t-esc="room.name"/></div>
                <div style="font-size:11px;color:#718096;margin-top:4px;"><t t-esc="room.current_occupancy"/>/<t t-esc="room.capacity"/> people</div>
              </div>
            </t>
          </div>
        </div>

        <div t-if="state.isStaff" class="lib-dashboard-grid">
          <div class="lib-card lib-animate">
            <div class="lib-card-header">
              <h3>📅 Pending Bookings</h3>
              <button class="lib-btn lib-btn-primary" t-on-click="() => this.setTab('bookings')">View All</button>
            </div>
            <t t-set="pending" t-value="state.bookings.filter(b => b.state === 'pending')"/>
            <div t-if="pending.length === 0" class="lib-empty">
              <div class="lib-empty-icon">✅</div>
              No pending bookings
            </div>
            <t t-foreach="pending.slice(0,5)" t-as="booking" t-key="booking.id">
              <div class="lib-booking-card pending">
                <div class="lib-booking-main">
                  <div>
                    <div class="lib-booking-title"><t t-esc="booking.name"/></div>
                    <div class="lib-booking-detail">🚪 <t t-esc="booking.room_id[1]"/></div>
                    <div class="lib-booking-detail">⏰ <t t-esc="booking.start_time"/></div>
                  </div>
                  <div class="lib-booking-actions">
                    <button class="lib-btn lib-btn-approve" t-on-click="() => this.approveBooking(booking.id)">✓ Approve</button>
                    <button class="lib-btn lib-btn-reject" t-on-click="() => this.rejectBooking(booking.id)">✗ Reject</button>
                  </div>
                </div>
              </div>
            </t>
          </div>

          <div class="lib-card lib-animate">
            <div class="lib-card-header">
              <h3>📋 Recent Borrowings</h3>
              <button class="lib-btn lib-btn-primary" t-on-click="() => this.setTab('borrows')">View All</button>
            </div>
            <div t-if="state.borrows.length === 0" class="lib-empty">
              <div class="lib-empty-icon">📚</div>
              No borrowings yet
            </div>
            <t t-foreach="state.borrows.slice(0,5)" t-as="borrow" t-key="borrow.id">
              <div t-att-class="'lib-member-card' + (borrow.is_overdue ? ' lib-overdue-row' : '')" t-on-click="() => this.openRecord('library.borrow', borrow.id)">
                <div class="lib-member-avatar">📖</div>
                <div class="lib-member-info">
                  <div class="lib-member-name"><t t-esc="borrow.name"/></div>
                  <div class="lib-member-id">Due: <t t-esc="borrow.due_date"/>
                    <span t-if="borrow.is_overdue" class="lib-overdue-tag">OVERDUE</span>
                  </div>
                </div>
                <span t-att-class="'lib-status ' + borrow.state"><t t-esc="borrow.state"/></span>
              </div>
            </t>
          </div>
        </div>

        <div t-if="state.isPortal" class="lib-dashboard-grid">
          <div class="lib-card lib-animate">
            <div class="lib-card-header"><h3>📖 Available Books</h3></div>
            <t t-foreach="state.books.filter(b => b.state === 'available').slice(0,5)" t-as="book" t-key="book.id">
              <div class="lib-member-card" t-on-click="() => this.openRecord('library.book', book.id)">
                <div class="lib-member-avatar">📚</div>
                <div class="lib-member-info">
                  <div class="lib-member-name"><t t-esc="book.name"/></div>
                  <div class="lib-member-id">by <t t-esc="book.author"/></div>
                </div>
                <span t-att-class="'lib-type-badge ' + book.book_type">
                  <t t-if="book.book_type === 'ebook'">💻 E-Book</t>
                  <t t-else="">📚 Physical</t>
                </span>
              </div>
            </t>
          </div>
          <div class="lib-card lib-animate">
            <div class="lib-card-header">
              <h3>🗓 Book a Room</h3>
              <button class="lib-btn lib-btn-primary" t-on-click="() => this.setTab('schedule')">View Schedule</button>
            </div>
            <t t-foreach="state.rooms.filter(r => r.state === 'available').slice(0,4)" t-as="room" t-key="room.id">
              <div class="lib-member-card" t-on-click="() => this.setTab('schedule')">
                <div class="lib-member-avatar">🚪</div>
                <div class="lib-member-info">
                  <div class="lib-member-name"><t t-esc="room.name"/></div>
                  <div class="lib-member-id">Capacity: <t t-esc="room.capacity"/> people</div>
                </div>
                <span t-if="room.is_crowded" class="lib-status borrowed">Crowded</span>
                <span t-else="" class="lib-status available">Available</span>
              </div>
            </t>
          </div>
        </div>
      </t>

      <!-- BOOKS TAB -->
      <t t-if="state.activeTab === 'books'">
        <div class="lib-page-header">
          <h2>📖 Books</h2>
          <button t-if="state.isStaff" class="lib-btn lib-btn-primary" t-on-click="() => this.openList('library.book')">+ New Book</button>
        </div>
        <div class="lib-filters">
          <button t-att-class="'lib-filter-btn' + (state.bookFilter === 'all' ? ' active' : '')" t-on-click="() => this.setBookFilter('all')">All Books</button>
          <button t-att-class="'lib-filter-btn' + (state.bookFilter === 'physical' ? ' active' : '')" t-on-click="() => this.setBookFilter('physical')">📚 Physical</button>
          <button t-att-class="'lib-filter-btn' + (state.bookFilter === 'ebook' ? ' active' : '')" t-on-click="() => this.setBookFilter('ebook')">💻 E-Books</button>
        </div>
        <div class="lib-filters" style="margin-top:6px;">
          <t t-foreach="bookCategories" t-as="cat" t-key="cat">
            <button t-att-class="'lib-filter-btn' + (state.categoryFilter === cat ? ' active' : '')"
              t-on-click="() => { this.state.categoryFilter = cat; }">
              <t t-if="cat === 'all'">All Categories</t>
              <t t-else=""><t t-esc="cat"/></t>
            </button>
          </t>
        </div>
        <input class="lib-search" type="text" placeholder="Search books by title or author..." t-model="state.searchBook"/>
        <div class="lib-books-grid">
          <t t-foreach="filteredBooks" t-as="book" t-key="book.id">
            <div class="lib-book-card" t-on-click="() => this.openRecord('library.book', book.id)">
              <div t-att-style="'height:120px;border-radius:10px;margin-bottom:14px;display:flex;align-items:center;justify-content:center;font-size:48px;background:' + (book.book_type === 'ebook' ? 'linear-gradient(135deg,#E6FFFA,#B2F5EA)' : 'linear-gradient(135deg,#EBF8FF,#BEE3F8)')">
                <t t-if="book.book_type === 'ebook'">💻</t>
                <t t-else="">📚</t>
              </div>
              <span t-att-class="'lib-type-badge ' + book.book_type">
                <t t-if="book.book_type === 'ebook'">E-Book</t>
                <t t-else="">Physical</t>
              </span>
              <div class="lib-book-title" style="margin-top:10px;font-size:15px;font-weight:700;"><t t-esc="book.name"/></div>
              <div class="lib-book-author" style="font-size:12px;color:#718096;margin-top:4px;">by <t t-esc="book.author"/></div>
              <div class="lib-book-footer">
                <span t-att-class="'lib-status ' + book.state"><t t-esc="book.state"/></span>
                <span t-if="book.book_type === 'physical'" style="font-size:12px;color:#718096;">
                  <t t-esc="book.available_copies"/>/<t t-esc="book.total_copies"/> copies
                </span>
                <span t-if="book.book_type === 'ebook'" style="font-size:12px;color:#38B2AC;font-weight:600;">
                  Unlimited Access
                </span>
              </div>
              <div t-if="state.isPortal" style="margin-top:8px;">
                <t t-if="book.book_type === 'ebook'">
                  <a t-att-href="book.download_url or '#'" target="_blank"
                    class="lib-btn lib-btn-primary" style="width:100%;font-size:12px;padding:6px;text-decoration:none;display:block;text-align:center;"
                    t-on-click.stop="() => {}">
                    💾 Download E-Book
                  </a>
                </t>
                <t t-else="">
                  <button t-if="book.available_copies > 0"
                    class="lib-btn lib-btn-primary" style="width:100%;font-size:12px;padding:6px;"
                    t-on-click="(ev) => { ev.stopPropagation(); this.requestBorrow(book.id); }">
                    📩 Request to Borrow
                  </button>
                  <button t-else=""
                    class="lib-btn" style="width:100%;font-size:12px;padding:6px;background:#D69E2E;color:white;border:none;cursor:pointer;border-radius:10px;"
                    t-on-click="(ev) => { ev.stopPropagation(); this.reserveBook(book.id, book.name); }">
                    🔔 Reserve When Available
                  </button>
                </t>
              </div>
            </div>
          </t>
        </div>
      </t>

      <!-- MEMBERS TAB -->
      <t t-if="state.activeTab === 'members' and state.isStaff">
        <div class="lib-page-header">
          <h2>👥 Members</h2>
          <button class="lib-btn lib-btn-primary" t-on-click="() => this.openList('library.member')">+ New Member</button>
        </div>
        <t t-foreach="state.members" t-as="member" t-key="member.id">
          <div class="lib-member-card" t-on-click="() => this.openRecord('library.member', member.id)">
            <div class="lib-member-avatar"><t t-esc="member.name[0]"/></div>
            <div class="lib-member-info">
              <div class="lib-member-name"><t t-esc="member.name"/></div>
              <div class="lib-member-id"><t t-esc="member.student_id"/> · <t t-esc="member.email"/></div>
              <div class="lib-member-stats">
                <span class="lib-member-stat">📚 <t t-esc="member.active_borrows"/>/<t t-esc="member.borrow_limit"/> books</span>
                <span class="lib-member-stat">🔥 <t t-esc="member.streak"/> streak</span>
              </div>
              <div style="margin-top:8px;background:#EDF2F7;border-radius:4px;height:4px;overflow:hidden;">
                <div t-att-style="'height:100%;border-radius:4px;background:' + (member.active_borrows >= member.borrow_limit ? '#E53E3E' : member.active_borrows > 0 ? '#ED8936' : '#48BB78') + ';width:' + (member.borrow_limit > 0 ? Math.round(member.active_borrows / member.borrow_limit * 100) : 0) + '%'"/>
              </div>
            </div>
            <span t-att-class="'lib-status ' + member.state"><t t-esc="member.state"/></span>
          </div>
        </t>
      </t>

      <!-- BORROWS TAB -->
      <t t-if="state.activeTab === 'borrows' and state.isStaff">
        <div class="lib-page-header"><h2>📋 Borrowings</h2></div>
        <div class="lib-card lib-animate">
          <div class="lib-table-wrap">
            <table class="lib-table">
              <thead>
                <tr>
                  <th>Reference</th><th>Member</th><th>Book</th>
                  <th>Borrow Date</th><th>Due Date</th><th>Fine</th><th>Status</th><th>Action</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.borrows" t-as="borrow" t-key="borrow.id">
                  <tr t-att-class="borrow.is_overdue ? 'lib-overdue-tr' : ''" t-on-click="() => this.openRecord('library.borrow', borrow.id)">
                    <td><t t-esc="borrow.name"/></td>
                    <td><t t-esc="borrow.member_id[1]"/></td>
                    <td><t t-esc="borrow.book_id[1]"/></td>
                    <td><t t-esc="borrow.borrow_date"/></td>
                    <td>
                      <span t-att-class="borrow.is_overdue ? 'lib-overdue-date' : ''">
                        <t t-esc="borrow.due_date"/>
                        <t t-if="borrow.is_overdue"> ⚠</t>
                      </span>
                    </td>
                    <td>
                      <span t-if="borrow.fine_amount &gt; 0" class="lib-fine">$<t t-esc="borrow.fine_amount.toFixed(2)"/></span>
                      <span t-else="">-</span>
                    </td>
                    <td><span t-att-class="'lib-status ' + borrow.state"><t t-esc="borrow.state"/></span></td>
                    <td>
                      <button t-if="borrow.state === 'borrowed'" class="lib-btn lib-btn-return" t-on-click.stop="() => this.returnBook(borrow.id)">Return</button>
                      <button t-if="borrow.state === 'pending'" class="lib-btn lib-btn-approve" style="margin-right:4px;" t-on-click.stop="() => this.approveBorrow(borrow.id)">✓ Approve</button>
                      <button t-if="borrow.state === 'pending'" class="lib-btn lib-btn-reject" t-on-click.stop="() => this.rejectBorrow(borrow.id)">✗ Reject</button>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </div>
      </t>

      <!-- ROOMS TAB -->
      <t t-if="state.activeTab === 'rooms'">
        <div class="lib-page-header">
          <h2>🚪 Study Rooms</h2>
          <button class="lib-btn lib-btn-primary" t-on-click="() => this.setTab('schedule')">🗓 View Schedule</button>
        </div>
        <div class="lib-rooms-grid">
          <t t-foreach="state.rooms" t-as="room" t-key="room.id">
            <div class="lib-room-card" t-on-click="() => this.openRecord('library.room', room.id)">
              <div class="lib-room-header">
                <div class="lib-room-name"><t t-esc="room.name"/></div>
                <div t-att-class="'lib-traffic-light-large lib-light-' + this.getRoomLight(room)">
                  <div class="lib-light-dot-large"/>
                  <span class="lib-light-label">
                    <t t-if="this.getRoomLight(room) === 'green'">Free</t>
                    <t t-elif="this.getRoomLight(room) === 'yellow'">Filling</t>
                    <t t-else="">Full</t>
                  </span>
                </div>
              </div>
              <div class="lib-occ-bar-wrap">
                <div class="lib-occ-bar-label">
                  <span>Occupancy</span>
                  <span><t t-esc="room.current_occupancy"/>/<t t-esc="room.capacity"/> people</span>
                </div>
                <div class="lib-occ-bar-track">
                  <div t-att-class="'lib-occ-bar-fill lib-occ-' + this.getRoomLight(room)"
                       t-att-style="'width:' + this.getRoomOccupancyPercent(room) + '%'"/>
                </div>
                <div class="lib-occ-percent"><t t-esc="this.getRoomOccupancyPercent(room)"/>%</div>
              </div>
              <div t-if="state.isStaff" class="lib-occ-controls" t-on-click.stop="">
                <button class="lib-occ-btn lib-occ-btn-minus" t-att-disabled="room.current_occupancy == 0" t-on-click="() => this.updateOccupancy(room.id, -1)">−</button>
                <span class="lib-occ-count"><t t-esc="room.current_occupancy"/>/<t t-esc="room.capacity"/></span>
                <button class="lib-occ-btn lib-occ-btn-plus" t-att-disabled="room.current_occupancy == room.capacity" t-on-click="() => this.updateOccupancy(room.id, 1)">+</button>
              </div>
              <div class="lib-room-stats">
                <div t-if="room.has_computers" class="lib-room-stat">
                  <div class="lib-room-stat-value">💻 <t t-esc="room.computers_available"/>/<t t-esc="room.computer_count"/></div>
                  <div class="lib-room-stat-label">Computers Free</div>
                </div>
                <div class="lib-room-stat">
                  <div class="lib-room-stat-value">
                    <t t-if="room.state === 'available'">✅</t>
                    <t t-elif="room.state === 'occupied'">🔴</t>
                    <t t-else="">🔧</t>
                    <t t-esc="room.state"/>
                  </div>
                  <div class="lib-room-stat-label">Status</div>
                </div>
              </div>
              <div t-if="room.is_crowded" class="lib-crowded">🔴 Crowded — 80%+ capacity</div>
            </div>
          </t>
        </div>
      </t>

      <!-- SCHEDULE TAB -->
      <t t-if="state.activeTab === 'schedule'">
        <div class="lib-page-header">
          <h2>🗓 Room Schedule</h2>
          <div style="display:flex;align-items:center;gap:12px;">
            <button class="lib-btn lib-btn-primary" t-on-click="() => this.changeScheduleDay(-1)" t-att-disabled="(state.scheduleOffset || 0) === 0">← Prev</button>
            <span style="font-size:14px;font-weight:700;color:#1E3A5F;background:#EBF8FF;padding:6px 16px;border-radius:8px;"><t t-esc="state.scheduleDate"/></span>
            <button class="lib-btn lib-btn-primary" t-on-click="() => this.changeScheduleDay(1)">Next →</button>
          </div>
        </div>

        <div class="lib-card lib-animate" style="overflow-x:auto;padding:0;">
          <table style="width:100%;border-collapse:collapse;min-width:500px;">
            <thead>
              <tr>
                <th style="padding:14px 16px;background:#1E3A5F;color:white;font-size:11px;font-weight:700;text-align:left;letter-spacing:0.5px;">TIME SLOT</th>
                <t t-foreach="state.rooms" t-as="room" t-key="room.id">
                  <th style="padding:14px 12px;background:#1E3A5F;color:white;font-size:11px;font-weight:700;text-align:center;letter-spacing:0.5px;">
                    <div><t t-esc="room.name"/></div>
                    <div style="font-size:10px;font-weight:400;opacity:0.75;margin-top:3px;">
                      Cap: <t t-esc="room.capacity"/>
                      <t t-if="room.has_computers"> · <t t-esc="room.computers_available"/> PC free</t>
                    </div>
                  </th>
                </t>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="[['08:30','08:30 - 10:30'],['10:30','10:30 - 12:30'],['12:30','12:30 - 14:30'],['14:30','14:30 - 16:30'],['16:30','16:30 - 18:30'],['18:30','18:30 - 20:30'],['20:30','20:30 - 22:30']]" t-as="slot" t-key="slot[0]">
                <tr style="border-bottom:1px solid #e2e8f0;">
                  <td style="padding:10px 16px;font-size:13px;font-weight:700;color:#1E3A5F;background:#f8fafc;white-space:nowrap;border-right:2px solid #e2e8f0;">
                    <t t-esc="slot[1]"/>
                  </td>
                  <t t-foreach="state.rooms" t-as="room" t-key="room.id">
                    <t t-set="slotKey" t-value="room.id + '-' + slot[0]"/>
                    <t t-set="slotData" t-value="state.schedule[slotKey]"/>
                    <td style="padding:8px;text-align:center;border-right:1px solid #f0f4f8;">

                      <t t-if="!slotData">
                        <div style="background:#f0fff4;border:1px solid #9ae6b4;border-radius:8px;padding:10px 6px;cursor:pointer;" t-on-click="() => this.bookSlot(room.id, slot[0])">
                          <div style="color:#276749;font-size:11px;font-weight:700;margin-bottom:4px;">✓ AVAILABLE</div>
                          <button style="background:#38a169;color:white;border:none;border-radius:6px;padding:4px 12px;font-size:11px;cursor:pointer;font-weight:600;">Book Now</button>
                        </div>
                      </t>

                      <t t-elif="slotData.state === 'pending'">
                        <div style="background:#fffbeb;border:1px solid #f6e05e;border-radius:8px;padding:10px 6px;">
                          <div style="color:#744210;font-size:11px;font-weight:700;">⏳ PENDING</div>
                          <t t-if="state.isStaff">
                            <div style="font-size:10px;color:#744210;margin-top:3px;font-weight:600;"><t t-esc="slotData.member"/></div>
                            <div style="font-size:10px;color:#92400e;"><t t-esc="slotData.group_size"/> people</div>
                          </t>
                          <t t-else="">
                            <div style="font-size:10px;color:#92400e;margin-top:3px;">Awaiting approval</div>
                          </t>
                        </div>
                      </t>

                      <t t-else="">
                        <div t-att-style="slotData.state === 'active' ? 'background:#ebfff4;border:1px solid #68d391;border-radius:8px;padding:10px 6px;' : 'background:#fff5f5;border:1px solid #feb2b2;border-radius:8px;padding:10px 6px;'">
                          <div t-att-style="slotData.state === 'active' ? 'color:#276749;font-size:11px;font-weight:700;' : 'color:#742a2a;font-size:11px;font-weight:700;'">
                            <t t-if="slotData.state === 'active'">🟢 ACTIVE</t>
                            <t t-else="">🔴 BOOKED</t>
                          </div>
                          <t t-if="state.isStaff">
                            <div style="font-size:10px;margin-top:3px;font-weight:600;" t-att-style="slotData.state === 'active' ? 'color:#276749;' : 'color:#742a2a;'"><t t-esc="slotData.member"/></div>
                            <div style="font-size:10px;" t-att-style="slotData.state === 'active' ? 'color:#2f855a;' : 'color:#9b2c2c;'"><t t-esc="slotData.group_size"/> people</div>
                          </t>
                          <t t-else="">
                            <div style="font-size:10px;color:#9b2c2c;margin-top:3px;">Not available</div>
                          </t>
                        </div>
                      </t>

                    </td>
                  </t>
                </tr>
              </t>
            </tbody>
          </table>
        </div>

        <div style="margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#4a5568;">
            <div style="width:12px;height:12px;border-radius:50%;background:#38a169;"></div> Available
          </div>
          <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#4a5568;">
            <div style="width:12px;height:12px;border-radius:50%;background:#d69e2e;"></div> Pending approval
          </div>
          <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#4a5568;">
            <div style="width:12px;height:12px;border-radius:50%;background:#e53e3e;"></div> Booked
          </div>
          <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#4a5568;">
            <div style="width:12px;height:12px;border-radius:50%;background:#38a169;opacity:0.6;"></div> Active session
          </div>
          <div style="margin-left:auto;font-size:12px;color:#718096;">Min 3 people · Max 2 slots per day · Auto-cancel after 10 min</div>
        </div>
      </t>

      <!-- BOOKINGS TAB -->
      <t t-if="state.activeTab === 'bookings'">
        <div class="lib-page-header">
          <h2>📅 Room Bookings</h2>
          <button class="lib-btn lib-btn-primary" t-on-click="() => this.openList('library.room.booking')">+ New Booking</button>
        </div>
        <div class="lib-filters">
          <button t-att-class="'lib-filter-btn' + (state.bookingFilter === 'all' ? ' active' : '')" t-on-click="() => this.setBookingFilter('all')">All</button>
          <button t-att-class="'lib-filter-btn' + (state.bookingFilter === 'pending' ? ' active' : '')" t-on-click="() => this.setBookingFilter('pending')">⏳ Pending</button>
          <button t-att-class="'lib-filter-btn' + (state.bookingFilter === 'approved' ? ' active' : '')" t-on-click="() => this.setBookingFilter('approved')">✅ Approved</button>
          <button t-att-class="'lib-filter-btn' + (state.bookingFilter === 'active' ? ' active' : '')" t-on-click="() => this.setBookingFilter('active')">🟢 Active</button>
          <button t-att-class="'lib-filter-btn' + (state.bookingFilter === 'done' ? ' active' : '')" t-on-click="() => this.setBookingFilter('done')">🏁 Done</button>
        </div>
        <t t-foreach="state.bookings" t-as="booking" t-key="booking.id">
          <div t-att-class="'lib-booking-card ' + booking.state">
            <div class="lib-booking-main">
              <div>
                <div class="lib-booking-title"><t t-esc="booking.name"/></div>
                <div class="lib-booking-detail">🚪 <t t-esc="booking.room_id[1]"/></div>
                <div class="lib-booking-detail">⏰ <t t-esc="booking.start_time"/> → <t t-esc="booking.end_time"/></div>
                <div class="lib-booking-detail">⏱ <t t-esc="booking.duration_hours"/> hours</div>
              </div>
              <div>
                <span t-att-class="'lib-status ' + booking.state"><t t-esc="booking.state"/></span>
                <div t-if="state.isStaff" class="lib-booking-actions">
                  <button t-if="booking.state === 'pending'" class="lib-btn lib-btn-approve" t-on-click="() => this.approveBooking(booking.id)">✓ Approve</button>
                  <button t-if="booking.state === 'pending'" class="lib-btn lib-btn-reject" t-on-click="() => this.rejectBooking(booking.id)">✗ Reject</button>
                  <button t-if="booking.state === 'approved'" class="lib-btn lib-btn-checkin" t-on-click="() => this.checkinBooking(booking.id)">Check In</button>
                  <button t-if="booking.state === 'active'" class="lib-btn lib-btn-checkout" t-on-click="() => this.checkoutBooking(booking.id)">Check Out</button>
                </div>
              </div>
            </div>
            <div t-if="booking.qr_code" class="lib-qr-section">
              <div class="lib-qr-label">📱 QR Code — Hover to enlarge</div>
              <img t-att-src="'data:image/png;base64,' + booking.qr_code" class="lib-qr-img" alt="QR Code"/>
            </div>
          </div>
        </t>
      </t>

      <!-- SETTINGS TAB -->
      <t t-if="state.activeTab === 'stats' and state.isStaff">
        <div class="lib-page-header"><h2>📊 Library Statistics</h2></div>
        <div class="lib-stats-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;">
          <div class="lib-stat-card" style="text-align:center;">
            <div style="font-size:36px;font-weight:700;color:#2b6cb0;"><t t-esc="state.stats.books"/></div>
            <div style="color:#718096;">Total Books</div>
          </div>
          <div class="lib-stat-card" style="text-align:center;">
            <div style="font-size:36px;font-weight:700;color:#276749;"><t t-esc="state.stats.members"/></div>
            <div style="color:#718096;">Total Members</div>
          </div>
          <div class="lib-stat-card" style="text-align:center;">
            <div style="font-size:36px;font-weight:700;color:#c05621;"><t t-esc="state.stats.borrows"/></div>
            <div style="color:#718096;">Active Borrows</div>
          </div>
          <div class="lib-stat-card" style="text-align:center;">
            <div style="font-size:36px;font-weight:700;color:#e53e3e;"><t t-esc="state.stats.overdueCount"/></div>
            <div style="color:#718096;">Overdue Books</div>
          </div>
          <div class="lib-stat-card" style="text-align:center;">
            <div style="font-size:36px;font-weight:700;color:#553c9a;"><t t-esc="state.stats.rooms"/></div>
            <div style="color:#718096;">Study Rooms</div>
          </div>
          <div class="lib-stat-card" style="text-align:center;">
            <div style="font-size:36px;font-weight:700;color:#b7791f;"><t t-esc="state.stats.pendingBookings"/></div>
            <div style="color:#718096;">Pending Bookings</div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="lib-stat-card">
            <h3 style="margin-bottom:12px;">🏆 Most Borrowed Books</h3>
            <t t-foreach="state.topBooks" t-as="book" t-key="book.id">
              <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #e2e8f0;">
                <span><t t-esc="book.name"/></span>
                <span style="font-weight:700;color:#2b6cb0;"><t t-esc="book.borrow_count"/>x</span>
              </div>
            </t>
          </div>
          <div class="lib-stat-card">
            <h3 style="margin-bottom:12px;">👥 Top Borrowers</h3>
            <t t-foreach="state.topMembers" t-as="member" t-key="member.id">
              <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #e2e8f0;">
                <span><t t-esc="member.name"/></span>
                <span style="font-weight:700;color:#276749;"><t t-esc="member.total_borrows"/> books</span>
              </div>
            </t>
          </div>
        </div>
      </t>
      <!-- PROFILE TAB -->
      <t t-if="state.activeTab === 'profile' and state.isPortal">
        <div class="lib-page-header">
          <h2>👤 My Profile</h2>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          <div style="background:white;border-radius:16px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <h3 style="font-size:16px;font-weight:700;color:#2d3748;margin-bottom:16px;">📚 My Active Borrows</h3>
            <t t-foreach="state.borrows.filter(b => b.state === 'borrowed' or b.state === 'pending')" t-as="borrow" t-key="borrow.id">
              <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f0f4f8;">
                <div>
                  <div style="font-size:14px;font-weight:600;color:#1a202c;"><t t-esc="borrow.book_id[1]"/></div>
                  <div style="font-size:12px;color:#718096;">Due: <t t-esc="borrow.due_date"/></div>
                </div>
                <span t-att-class="'lib-status ' + borrow.state"><t t-esc="borrow.state"/></span>
              </div>
            </t>
            <div t-if="state.borrows.filter(b => b.state === 'borrowed' or b.state === 'pending').length === 0" style="text-align:center;padding:24px;color:#a0aec0;">
              No active borrows
            </div>
          </div>
          <div style="background:white;border-radius:16px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <h3 style="font-size:16px;font-weight:700;color:#2d3748;margin-bottom:16px;">🔔 My Reservations</h3>
            <t t-foreach="state.myReservations" t-as="res" t-key="res.id">
              <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f0f4f8;">
                <div>
                  <div style="font-size:14px;font-weight:600;color:#1a202c;"><t t-esc="res.book_id[1]"/></div>
                  <div style="font-size:12px;color:#718096;">Reserved: <t t-esc="res.reservation_date"/></div>
                </div>
                <span t-att-class="'lib-status ' + res.state"><t t-esc="res.state"/></span>
              </div>
            </t>
            <div t-if="state.myReservations.length === 0" style="text-align:center;padding:24px;color:#a0aec0;">
              No reservations
            </div>
          </div>
          <div style="background:white;border-radius:16px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <h3 style="font-size:16px;font-weight:700;color:#2d3748;margin-bottom:16px;">📅 My Room Bookings</h3>
            <t t-foreach="state.myBookings" t-as="booking" t-key="booking.id">
              <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f0f4f8;">
                <div>
                  <div style="font-size:14px;font-weight:600;color:#1a202c;"><t t-esc="booking.room_id[1]"/></div>
                  <div style="font-size:12px;color:#718096;"><t t-esc="booking.booking_date"/> <t t-if="booking.time_slot">— <t t-esc="booking.time_slot"/></t></div>
                </div>
                <span t-att-class="'lib-status ' + booking.state"><t t-esc="booking.state"/></span>
              </div>
            </t>
            <div t-if="state.myBookings.length === 0" style="text-align:center;padding:24px;color:#a0aec0;">
              No room bookings
            </div>
          </div>
          <div style="background:white;border-radius:16px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.06);">
            <h3 style="font-size:16px;font-weight:700;color:#2d3748;margin-bottom:16px;">📖 Borrow History</h3>
            <t t-foreach="state.borrows.filter(b => b.state === 'returned')" t-as="borrow" t-key="borrow.id">
              <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f0f4f8;">
                <div>
                  <div style="font-size:14px;font-weight:600;color:#1a202c;"><t t-esc="borrow.book_id[1]"/></div>
                  <div style="font-size:12px;color:#718096;">Returned: <t t-esc="borrow.return_date"/></div>
                </div>
                <span class="lib-status returned">Returned</span>
              </div>
            </t>
            <div t-if="state.borrows.filter(b => b.state === 'returned').length === 0" style="text-align:center;padding:24px;color:#a0aec0;">
              No history yet
            </div>
          </div>
        </div>
      </t>
      <t t-if="state.activeTab === 'settings' and state.isAdmin">
        <div class="lib-page-header"><h2>⚙ Library Settings</h2></div>
        <div class="lib-settings-card lib-animate">
          <div class="lib-setting-item">
            <div class="lib-setting-info">
              <h4>Show Announcement Banner</h4>
              <p>Display an announcement to all library users</p>
            </div>
            <label class="lib-toggle">
              <input type="checkbox" t-model="state.showAnnouncement" t-on-change="() => this.saveSetting('library.show_warning', state.showAnnouncement)"/>
              <span class="lib-toggle-slider"/>
            </label>
          </div>
          <div t-if="state.showAnnouncement" class="lib-setting-item">
            <div class="lib-setting-info">
              <h4>Announcement Message</h4>
              <textarea style="width:400px;padding:10px;border:2px solid #e2e8f0;border-radius:8px;font-size:14px;"
                t-model="state.announcement"
                t-on-blur="() => this.saveSetting('library.warning_message', state.announcement)"
                placeholder="Type your announcement..."/>
            </div>
          </div>
        </div>
      </t>

    <!-- BOOKING MODAL -->
    <div t-if="state.showBookingModal" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;display:flex;align-items:center;justify-content:center;">
      <div style="background:white;border-radius:20px;padding:32px;width:480px;max-width:90vw;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
          <h2 style="font-size:20px;font-weight:800;color:#1E3A5F;">📅 Book a Room</h2>
          <button t-on-click="() => { this.state.showBookingModal = false; }" style="background:none;border:none;font-size:20px;cursor:pointer;color:#718096;">✕</button>
        </div>
        <div style="margin-bottom:16px;">
          <label style="font-size:13px;font-weight:600;color:#4a5568;display:block;margin-bottom:6px;">Date</label>
          <div style="padding:10px 14px;background:#f7fafc;border-radius:10px;font-size:14px;color:#2d3748;font-weight:600;"><t t-esc="state.modalDate"/></div>
        </div>
        <div style="margin-bottom:16px;">
          <label style="font-size:13px;font-weight:600;color:#4a5568;display:block;margin-bottom:6px;">Time Slot</label>
          <div style="padding:10px 14px;background:#f7fafc;border-radius:10px;font-size:14px;color:#2d3748;font-weight:600;"><t t-esc="state.modalSlot"/> - <t t-esc="state.modalSlot"/></div>
        </div>
        <div style="margin-bottom:16px;">
          <label style="font-size:13px;font-weight:600;color:#4a5568;display:block;margin-bottom:6px;">Group Size (min 3)</label>
          <input type="number" min="3" max="30"
            t-att-value="state.modalGroupSize"
            t-on-change="(e) => { this.state.modalGroupSize = parseInt(e.target.value); }"
            style="width:100%;padding:10px 14px;border:2px solid #e2e8f0;border-radius:10px;font-size:14px;box-sizing:border-box;"/>
        </div>
        <div style="margin-bottom:16px;">
          <label style="font-size:13px;font-weight:600;color:#4a5568;display:block;margin-bottom:6px;">Language</label>
          <select t-on-change="(e) => { this.state.modalLanguage = e.target.value; }"
            style="width:100%;padding:10px 14px;border:2px solid #e2e8f0;border-radius:10px;font-size:14px;box-sizing:border-box;">
            <option value="en">English</option>
            <option value="tr">Türkçe</option>
          </select>
        </div>
        <div style="margin-bottom:24px;display:flex;align-items:center;gap:10px;">
          <input type="checkbox" id="needsComputer"
            t-on-change="(e) => { this.state.modalNeedsComputer = e.target.checked; }"
            style="width:18px;height:18px;cursor:pointer;"/>
          <label for="needsComputer" style="font-size:14px;font-weight:600;color:#4a5568;cursor:pointer;">Needs Computer</label>
        </div>
        <div style="display:flex;gap:12px;">
          <button t-on-click="() => { this.state.showBookingModal = false; }"
            style="flex:1;padding:12px;border:2px solid #e2e8f0;background:white;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;color:#4a5568;">
            Cancel
          </button>
          <button t-on-click="() => this.submitBooking()"
            style="flex:1;padding:12px;background:linear-gradient(135deg,#1E3A5F,#2D6A9F);color:white;border:none;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;">
            Confirm Booking
          </button>
        </div>
      </div>
    </div>
    </div>
  </div>
</t>
</templates>
